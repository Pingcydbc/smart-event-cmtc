# ============================================================
# Smart Event CMTC - Environment Configuration Template
# ============================================================
# คำแนะนำ: คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงของระบบ (ห้ามนำ .env ขึ้น Git เด็ดขาด)

# 1. ฐานข้อมูล PostgreSQL (Supabase Connection Pooling String)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres"

# 2. คีย์สำหรับเข้ารหัสความปลอดภัย JWT Token
JWT_SECRET="your_jwt_super_secret_key_here"

# 3. ข้อมูล LINE Messaging API (ดึงจาก LINE Developers Console)
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# 4. พอร์ตสำหรับรัน Backend Server
PORT=5000
